# ---- Model (OpenAI) ----
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5-mini

# ---- Lifecycle controls (per-request budget caps) ----
# Max agent loop iterations (turns) per request.
MAX_TURNS=6
# Max cumulative model output tokens per request.
MAX_OUTPUT_TOKENS=2048
# Max cumulative total tokens (input + output) per request. Leave empty for no cap.
MAX_TOTAL_TOKENS=

# ---- Session store (SQLite) ----
# Path to the SQLite database backing the session store.
SESSION_DB_PATH=sessions.db

# ---- MCP server ----
# Streamable HTTP URL of the MCP server whose tools are loaded at startup.
# Start the bundled server with: python -m mcp_server.server
MCP_SERVER_URL=http://localhost:8001/mcp

# ---- OpenTelemetry export ----
# When set, traces/metrics are exported to this OTLP endpoint.
# Leave empty to fall back to the console exporter (handy for local runs).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name reported in traces.
OTEL_SERVICE_NAME=fastapi-strands-starter
